{
  "description": "Keeps Sessions/Progress.md append-only",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/progress_guard.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/progress_guard.py\""
          }
        ]
      }
    ]
  }
}
